{
  "name": "@cynosure-mcp/computer-controller",
  "mcpName": "io.github.andreasjhagen/computer-controller",
  "version": "2.0.1",
  "description": "MCP server for desktop automation: launch apps, capture screenshots, control mouse and keyboard",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "computer-controller": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "release:check": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add server.json"
  },
  "dependencies": {
    "@hurdlegroup/robotjs": "^0.12.3",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "pngjs": "^7.0.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "koffi": "^3.3.2",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "server.json",
    "icon.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "desktop-automation",
    "screenshot",
    "mouse",
    "keyboard",
    "computer-use",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-computer-controller.git"
  },
  "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-computer-controller#readme",
  "bugs": {
    "url": "https://github.com/Cynosure-MCP-Collection/mcp-computer-controller/issues"
  }
}
